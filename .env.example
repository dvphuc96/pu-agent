# PU Agent configuration template. Keep secrets empty in source control.
PU_PROVIDER=anthropic
PU_MODEL=
PU_SMALL_MODEL=
PU_HOME=
PU_MAX_ITERATIONS=
PU_MAX_TOKENS=
PU_HISTORY_TURNS=
PU_CONSOLIDATE_EVERY=
PU_RETRIEVAL_TOP_K=
PU_TOOL_RATE_LIMIT_PER_MINUTE=
PU_TOOL_READ_RETRIES=
PU_APPROVAL_TTL_MINUTES=
PU_REPORT_QUALITY_MIN_SCORE=
PU_REPORT_MIN_COMPLETENESS=
PU_REPORT_MIN_SOURCE_COVERAGE=
PU_REPORT_FRESHNESS_DAYS=
PU_REPORT_JUDGE=
PU_REPORT_JUDGE_MODEL=
PU_GRAPH_WORKFLOWS=
PU_SLO_LLM_P95_MS=
PU_SLO_TOOL_ERROR_RATE=
PU_SLO_WORKFLOW_SUCCESS_RATE=
PU_SLO_APPROVAL_FAILURE_RATE=
PU_SLO_SECURITY_BLOCKS_MAX=

# BEGIN GENERATED CONNECTIONS
# Generated by scripts/generate_env_example.py; definitions live in pu/integrations.py

# PU_PROVIDER=anthropic

# ── AI Providers ──

# ── Anthropic ──
# Uses Anthropic models.
# Setup: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# PU_ANTHROPIC_BASE_URL=

# ── OpenAI ──
# Uses OpenAI models.
# Setup: https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# PU_OPENAI_BASE_URL=

# ── OpenRouter ──
# Uses OpenRouter models.
# Setup: https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=
# PU_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── DeepSeek ──
# Uses DeepSeek models.
# Setup: https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=
# PU_DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── GLM ──
# Uses GLM models.
# Setup: https://z.ai/model-api
# ZAI_API_KEY=
# Choices: https://api.z.ai/api/paas/v4, https://api.z.ai/api/coding/paas/v4.
# PU_GLM_BASE_URL=https://api.z.ai/api/paas/v4

# ── Gemini ──
# Uses Gemini models.
# Setup: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# PU_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ── Calendar & Productivity ──

# ── Google Calendar ──
# Lets PU create and update Google Calendar events.
# Install: pip install -e '.[gcal]'
# Setup: https://developers.google.com/calendar/api/quickstart/python
# Set to 1 to enable.
# PU_GOOGLE_CALENDAR=
# PU_GOOGLE_CALENDAR_ID=primary

# ── Knowledge ──

# ── Google Drive ──
# Imports supported text documents from Google Drive into the local Knowledge base.
# Install: pip install -e '.[drive]'
# Setup: https://console.cloud.google.com/apis/library/drive.googleapis.com
# Set to 1 to enable.
# PU_DRIVE=

# ── Email ──

# ── Gmail ──
# Pulls email from Gmail into the local inbox (read-only in the current baseline).
# Install: pip install -e '.[gmail]'
# Setup: https://console.cloud.google.com/apis/library/gmail.googleapis.com
# Set to 1 to enable.
# PU_GMAIL=
# PU_GMAIL_LABEL=INBOX
# PU_GMAIL_MAX_MESSAGES=50

# ── Research ──

# ── Tavily ──
# Lets PU search the web.
# Setup: https://tavily.com
# TAVILY_API_KEY=

# ── Observability ──

# ── OpenTelemetry ──
# Exports traces to an OTLP collector.
# Install: pip install -e '.[tracing]'
# OTEL_EXPORTER_OTLP_ENDPOINT=

# END GENERATED CONNECTIONS
